# SimplePharmaAPI Environment Configuration
# 100% Free & Standalone - Zero External Database Required!

# Server Port (Render sets this dynamically via $PORT)
PORT=3000
NODE_ENV=development

# Optional: Google Gemini API Key (for experimental fallback on uncataloged medicines)
GEMINI_API_KEY=

# OpenFDA Base URL
OPENFDA_BASE_URL=https://api.fda.gov/drug/label.json
